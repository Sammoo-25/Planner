# Copy to .env and fill in. Never commit .env.

# Postgres (compose creates this user/database on first start)
DB_USER=planer
DB_PASSWORD=change-me
# Keep as "planer" (backend/db.js creates this database name)
DB_NAME=planer

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Optional external AI service; if unreachable the backend returns 503 fallbacks.
# Leave the secret empty unless you run the agent service. Generate with: openssl rand -hex 32
AGENT_SERVICE_SECRET=
AGENT_SERVICE_URL=http://host.docker.internal:8000

# Baked into the frontend at build time; the browser calls this URL
NEXT_PUBLIC_API_URL=http://localhost:5005/api
