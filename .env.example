# Copy to .env and fill in. Never commit .env.

# Postgres (compose creates this user/database on first start)
DB_USER=planer
DB_PASSWORD=change-me
# Database name; default "planer" (the spelling is intentional), lowercase letters/digits/_ only
DB_NAME=planer

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Optional external AI service; if unreachable the backend returns 503 fallbacks.
# Leave the secret empty unless you run the agent service. Generate with: openssl rand -hex 32
# Must be >= 32 chars to enable POST /api/events (otherwise it returns 503)
AGENT_SERVICE_SECRET=
AGENT_SERVICE_URL=http://host.docker.internal:8000

# Baked into the frontend at build time; the browser calls this URL
NEXT_PUBLIC_API_URL=http://localhost:5005/api

# Browser origins allowed by CORS (comma-separated). Required when NODE_ENV=production.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# NODE_ENV=production (set on the host, not in compose) requires CORS_ORIGIN and bans the insecure DB TLS flags.
# Only when using DATABASE_URL (TLS is verified by default):
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----   (CA for verified TLS in production)
# DB_SSL=false   (no TLS, e.g. local DATABASE_URL; refused in production)
# DB_SSL_INSECURE=true   (TLS without cert verification, dev only; refused in production)
